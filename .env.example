# =============================================================================
# Root environment for docker-compose (copy to .env and adjust).
#
# Legend:
#   [example]  safe placeholder, works for local development as-is
#   [change]   must be changed for your local setup if defaults conflict
#   [secret]   MUST be generated/kept secret; never commit real values
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=postgres          # [change] database user
POSTGRES_PASSWORD=postgres      # [secret] change for anything beyond local dev
POSTGRES_DB=get_it_done         # [example] database name
POSTGRES_PORT=5432              # [change] host-published port for postgres

# --- Backend ----------------------------------------------------------------
# [secret] required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# [example] token lifetime (jsonwebtoken format)
JWT_EXPIRES_IN=1h
# [change] comma-separated list of browser origins allowed to call the API.
# Set this to the frontend's public origin(s) when deploying.
CORS_ORIGIN=http://localhost:3000

# --- Frontend build args ----------------------------------------------------
# [example] URL the *browser* uses to reach the backend. NEXT_PUBLIC_* vars are
# baked into the frontend at image build time by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_PREFIX=/api
