# Base URL of the backend API server, as reached from the *browser*.
# NOTE: NEXT_PUBLIC_* variables are inlined into the client bundle at build
# time by Next.js. When the frontend runs in docker-compose this file is not
# used — compose passes NEXT_PUBLIC_API_URL as a Docker build arg instead
# (see root .env.example).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Path prefix the backend mounts its routes under.
NEXT_PUBLIC_API_PREFIX=/api
