# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Database
#
# Local development default; must match docker-compose.yml (root of the repo).
# The compose file reads POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB /
# POSTGRES_PORT from a root `.env` file — if you change them there, update
# DATABASE_URL below to match.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/get_it_done?schema=public
