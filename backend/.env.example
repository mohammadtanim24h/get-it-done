# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Database
#
# Used when running the backend on the host (npm run dev) against the
# dockerized PostgreSQL. Must match the POSTGRES_* values in the root .env
# (see .env.example at the repo root). When the backend itself runs in
# docker-compose, this file is NOT used — compose injects DATABASE_URL with
# host `postgres` directly.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/get_it_done?schema=public

# Auth
# [secret] Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Token lifetime (jsonwebtoken format, e.g. 30m, 1h, 7d)
JWT_EXPIRES_IN=1h
JWT_COOKIE_NAME=access_token
