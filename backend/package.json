{
  "name": "get-it-done-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Get It Done - Kanban board API (Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
